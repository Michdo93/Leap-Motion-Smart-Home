# Kapitel 16 – USB/IP-Client (z. B. Ubuntu-VM), Instanz = Bus-ID auf dem Server
# Datei: /etc/systemd/system/usbip-client@.service
# Server-Adresse in /etc/default/usbip-client:  USBIP_SERVER=192.168.0.231
[Unit]
Description=USB/IP Client Attach/Detach Service for %i
After=network-online.target
Wants=network-online.target
Before=shutdown.target reboot.target halt.target

[Service]
Type=idle
EnvironmentFile=/etc/default/usbip-client
ExecStartPre=/usr/sbin/modprobe vhci-hcd
ExecStart=/usr/sbin/usbip attach -r ${USBIP_SERVER} -b %i
ExecStop=/usr/bin/sh -c '/usr/sbin/usbip port | grep "<Port in Use>" | awk "{print \$2}" | tr -d ":" | xargs -r -n1 /usr/sbin/usbip detach -p'
RemainAfterExit=yes
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
