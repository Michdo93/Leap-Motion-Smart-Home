String Leap_Multimedia_Modus "Leap-Modus [%s]" <settings> (gLeapMultimedia)
    { stateDescription=" "[ options="ROLLLADEN=Rollläden,JALOUSIE=Jalousien,LICHT=Licht,WEBRADIO=Webradio" ] }

String Leap_Multimedia_Webradio_Sender "Aktueller Sender [%s]" <radio> (gLeapMultimedia)
